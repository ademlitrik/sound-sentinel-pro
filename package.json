{
  "name": "sound-sentinel",
  "version": "1.0.0",
  "description": "AI-Powered Real-time Household Sound Tracking Desktop Application",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --enable-logging",
    "test": "node scripts/test_app.js",
    "dist": "electron-builder --win nsis",
    "dist:portable": "electron-builder --win portable",
    "dist:all": "electron-builder --win"
  },
  "keywords": [
    "sound-tracker",
    "acoustic-monitoring",
    "ai",
    "yamnet",
    "electron",
    "smart-home"
  ],
  "author": "Antigravity",
  "license": "ISC",
  "build": {
    "appId": "com.soundsentinel.app",
    "productName": "Sound Sentinel",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "model/**/*",
      "node_modules/@tensorflow/tfjs/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "src/assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Sound Sentinel"
    }
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "@tensorflow/tfjs": "^4.22.0"
  }
}
